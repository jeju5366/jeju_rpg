VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# 서버 전용 (VITE_ 접두사 금지). DATA_MODE 를 live 로 하면 실제 호출, 비우면 mock(데모 데이터)
DATA_MODE=
# 공공데이터포털 API 별 인증키 (API 마다 활용 신청/키가 따로)
TOUR_API_KEY=
KMA_API_KEY=
TAGO_API_KEY=
AIRPORT_API_KEY=
# 한국공항공사 API 주소를 바꿔야 할 때만 (비우면 기본 주소)
AIRPORT_FLIGHT_STATUS_URL=
AIRPORT_CONGESTION_URL=

# NAVER Maps (Dynamic Map 과 Directions 5 가 같은 Application 의 Client ID/Secret 을 공유)
NAVER_MAP_CLIENT_ID=
NAVER_MAP_CLIENT_SECRET=
# 브라우저용 공개 키(Dynamic Map). NAVER Cloud 콘솔에 Web 서비스 URL 등록 필수
VITE_NAVER_MAP_CLIENT_ID=

# 서버 전용 (VITE_ 접두사 금지)
# OpenAI Agent (OPENAI_MODEL 을 비우면 기본 모델 사용)
# Supabase service_role: 서버가 모험/퀘스트/로그를 저장할 때 사용. 브라우저에 절대 노출 금지
OPENAI_API_KEY=
OPENAI_MODEL=
# 사진 인증(이미지 입력 가능 모델). 비우면 OPENAI_MODEL 을 쓴다. 키는 서버에서만 쓴다 (VITE_ 접두사 금지)
OPENAI_PHOTO_MODEL=
OPENAI_PHOTO_REASONING_EFFORT=
SUPABASE_SERVICE_ROLE_KEY=
# 추론 모델(gpt-5 계열) 추론 강도: minimal/low/medium/high (비우면 low)
OPENAI_REASONING_EFFORT=
# 비용 로그용 가격(USD/1M 토큰). 기본 가격표에 없는 모델일 때만
OPENAI_PRICE_INPUT_PER_1M=
OPENAI_PRICE_OUTPUT_PER_1M=
